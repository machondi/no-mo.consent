{
    "manifest_version": 3,
    "name": "Auto Cookie Consent",
    "version": "1.0",
    "description": "Automatically clicks cookie consent dialogs.",
    "permissions": ["scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": ["<all_urls>"]
}
